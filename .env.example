# Copy this file to .env and fill it in. Only DISCORD_TOKEN is required.

# The bot's token: Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Servers the bot may play on, comma-separated (right-click the server icon ->
# Copy Server ID, with Developer Mode on). Leave empty to allow any server the
# bot is in, which is only safe with "Public Bot" turned off in the portal.
ALLOWED_GUILD_IDS=

# Optional: Stage or voice channels to join at start, comma-separated.
# Usually /radio join is easier; channels it joins are saved and rejoined.
STAGE_CHANNEL_ID=

# Optional. These defaults play Booty Bay Pirate Radio.
# STREAM_URL=https://radio.octowow.st/listen/booty_bay_pirate_radio/radio.mp3
# NOW_PLAYING_URL=https://radio.octowow.st/api/nowplaying/booty_bay_pirate_radio
# Leave NOW_PLAYING_URL empty to stop showing the song in the Stage topic.
# STAGE_TOPIC=Booty Bay Pirate Radio
# BITRATE=128
# How loud the bot plays, as a % of the station's level (1-100). Full level
# is too loud on a Stage, so it plays at half unless told otherwise.
# VOLUME=50
# Reopen the station's stream every so many hours, as a precaution against a
# connection gone wrong. The bot stays in its channels; about a second's gap.
# STREAM_REFRESH_HOURS=2
# Where joined channels are saved (default: the data folder here).
# DATA_DIR=

# Optional: a status page that tells radio-metrics how many people are
# listening on Discord. Off unless STATUS_PORT is set. Make the token long and
# random (at least 24 characters), for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STATUS_PORT=8790
# STATUS_TOKEN=
# Only this machine can reach it by default. To reach it from another computer
# set STATUS_HOST=0.0.0.0, open the port in the firewall, and give it a
# certificate for the server's name: radio-metrics sends the token over plain
# http only to this machine or the local network.
# STATUS_HOST=127.0.0.1
# STATUS_TLS_CERT=
# STATUS_TLS_KEY=
# The station's short name, which radio-metrics matches the counts by.
# Defaults to the part after /listen/ in STREAM_URL.
# STATION=
